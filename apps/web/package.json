{
  "name": "@family-chat/web",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:fcd": "playwright test -c playwright.fcd.config.ts",
    "test:e2e:big": "playwright test -c playwright.big.config.ts",
    "test:e2e:perf": "playwright test -c playwright.perf.config.ts"
  },
  "dependencies": {
    "@family-chat/core": "workspace:*",
    "lottie-web": "^5.13.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "6.2.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
