# family-chat: HTTPS proxy with CORS in front of the router's WebDAV
# (docs/PLAN.md 5, 6.11, 6.12).
#
# Set three environment variables before starting Caddy:
#   FC_SITE_ADDRESS     public name of this proxy, e.g. dav.example.net
#                       (Caddy gets a certificate for it automatically)
#   FC_CLIENT_ORIGIN    exact origin of the client, e.g. https://chat.example.net
#   FC_WEBDAV_UPSTREAM  the router's WebDAV, e.g. 192.168.1.1:5080
#                       (https://192.168.1.1 if it only speaks HTTPS)

# Expects the @fc_from_client matcher of the site below.
(fc_cors) {
	header @fc_from_client {
		Access-Control-Allow-Origin {$FC_CLIENT_ORIGIN}
		defer
	}
	header {
		-Access-Control-Allow-Credentials
		Vary Origin
		Access-Control-Allow-Methods "GET, PUT, DELETE, MKCOL, PROPFIND, OPTIONS"
		Access-Control-Allow-Headers "Authorization, Depth, Content-Type"
		# Date: clock offset. The rest only lets the probe verify this configuration.
		Access-Control-Expose-Headers "Date, Access-Control-Max-Age, Content-Security-Policy, X-Content-Type-Options"
		Access-Control-Max-Age 7200
		Cache-Control no-store
		# An .html uploaded by a member must not become a page under the family address.
		X-Content-Type-Options nosniff
		Content-Security-Policy sandbox
		defer
	}
}

{$FC_SITE_ADDRESS} {
	@fc_from_client header Origin {$FC_CLIENT_ORIGIN}
	import fc_cors

	# Preflight: answered here, without authentication.
	@fc_preflight method OPTIONS
	respond @fc_preflight 204

	# Paths pass unchanged; Date comes from the WebDAV server.
	reverse_proxy {$FC_WEBDAV_UPSTREAM} {
		header_up Host {upstream_hostport}
		header_down -Access-Control-Allow-Origin
		header_down -Access-Control-Expose-Headers
	}

	# CORS also on errors produced by Caddy itself (e.g. 502 when the router is off).
	handle_errors {
		import fc_cors
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
